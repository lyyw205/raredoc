generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 지역별 발매판(printing) 1행. region 으로 EN/JP/KR 구분, setGroupId 로 동일 확장팩 연결.
model Set {
  id          String      @id
  name        String
  nameKo      String?
  nameJa      String?
  series      String
  releaseDate DateTime
  cardCount   Int
  logoUrl     String?
  symbolUrl   String?
  region      String      @default("EN") // EN | JP | KR
  code        String? // 지역 팩 코드 (EN ptcgoCode / JP sv2a / KR 사이트ID 등)
  setGroupId  String?
  setGroup    SetGroup?   @relation(fields: [setGroupId], references: [id])
  tierEntries TierEntry[]
  primarySetForLogical LogicalCard[] @relation("LogicalCardPrimarySet")
  localeCards          CardLocale[]  @relation("CardLocaleSet")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([series])
  @@index([releaseDate])
  @@index([region])
  @@index([setGroupId])
}

// 논리적 확장팩(예: "151"). 한 그룹에 지역별 Set 이 1~여러 개(EN이 JP 2팩을 합본하기도 함).
// 부분 그룹 허용: JP/KR 만 있고 EN 이 없을 수도 있음(예: MEGA 시리즈) — 억지 매핑 금지.
model SetGroup {
  id          String    @id // slug 예: "sv-151", "sv-base", "mega-abysseye"
  era         String // SV | MEGA | ...
  nameEn      String?
  nameJa      String?
  nameKo      String?
  releaseDate DateTime? // 그룹 기준일(보통 일본 최초 발매) — 정렬용
  order       Int       @default(0)
  sets        Set[]
  // Phase 1 추가: 신규 ERD 역방향 relation
  logicalCards LogicalCard[] @relation("LogicalCardSetGroup")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([era])
  @@index([order])
}

model Price {
  id           String       @id @default(cuid())
  cardLocaleId String
  cardLocale   CardLocale   @relation("PriceCardLocale", fields: [cardLocaleId], references: [id], onDelete: Cascade)
  sourceId     String?
  priceSource  PriceSource? @relation("PricePriceSource", fields: [sourceId], references: [id])
  normal       Float?
  holofoil     Float?
  reverseHolo  Float?
  firstEdition Float?
  marketPrice  Float? // 단일값 출처용 일반 시세(등급가·샵 販売/買取·해외 한국판 등). raw 변형 다출처는 normal/holofoil 사용.
  source       String       @default("ebay") // legacy 문자열(historical). Phase 5 후속에서 priceSource로만.
  currency     String       @default("USD")
  usdToKrw     Float?
  condition    String?
  gradingCompany String?
  grade        Int?
  recordedAt   DateTime     @default(now())

  @@index([cardLocaleId])
  @@index([recordedAt])
  @@index([sourceId])
}

model TierEntry {
  id            String      @id @default(cuid())
  logicalCardId String
  setId         String
  tier          String
  reason        String?
  reasonKo      String?
  reasonJa      String?
  logicalCard   LogicalCard @relation("TierEntryLogicalCard", fields: [logicalCardId], references: [id])
  set           Set         @relation(fields: [setId], references: [id])
  updatedAt     DateTime    @updatedAt

  @@unique([logicalCardId, setId])
  @@index([setId])
  @@index([logicalCardId])
  @@index([tier])
}

model Trade {
  id            String      @id @default(cuid())
  localeId      String // CardLocale.id — 실제 거래된 지역판
  logicalCardId String // LogicalCard.id — 시장 분석 dedupe
  soldAt        DateTime
  priceHighUsd  Float
  priceLowUsd   Float?
  priceAvgUsd   Float?
  saleCount     Int         @default(1)
  tier          String      @default("NEAR_MINT")
  source        String      @default("poketrace")
  locale        CardLocale  @relation("TradeLocale", fields: [localeId], references: [id])
  logicalCard   LogicalCard @relation("TradeLogicalCard", fields: [logicalCardId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([localeId, soldAt, tier, source])
  @@index([localeId])
  @@index([logicalCardId])
  @@index([soldAt])
  @@index([priceHighUsd])
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity / Auth (Auth.js v5 + Prisma Adapter)  — Phase 0
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String           @id @default(cuid())
  // Auth.js 표준 필드
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // 앱 프로필 필드 (OAuth 가입 직후엔 비어 있을 수 있어 nullable; 온보딩에서 채움)
  username      String?          @unique
  displayName   String?
  passwordHash  String?
  avatarInitial String?
  bio           String?
  tier          String           @default("BRONZE") // BRONZE/SILVER/GOLD/DIAMOND/LEGEND (파생·캐시)
  location      String?
  collection    CollectionItem[]
  posts         Post[]
  comments      Comment[]
  listings      Listing[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tier])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 — Collection
// ─────────────────────────────────────────────────────────────────────────────

model CollectionItem {
  id            String         @id @default(cuid())
  userId        String
  localeId      String // CardLocale.id — 실제 보유 지역판
  logicalCardId String // LogicalCard.id — SetGroup-level 카운트(랭킹/도감 dedupe)
  grade         String // NM/LP/MP/HP/VNDS/DS/미개봉/1착
  certified     Boolean        @default(false)
  estimatedKrw  Int?
  forSale       Boolean        @default(false)
  highlightSlot Int? // 1..5 (프로필 하이라이트). null = 비표시
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale        CardLocale     @relation("CollectionItemLocale", fields: [localeId], references: [id])
  logicalCard   LogicalCard    @relation("CollectionItemLogicalCard", fields: [logicalCardId], references: [id])
  certification Certification?
  listing       Listing?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([localeId])
  @@index([logicalCardId])
  @@index([userId, forSale])
  @@index([createdAt])
}

model Certification {
  id            String         @id @default(cuid())
  itemId        String         @unique
  photoUrl      String
  status        String         @default("pending") // pending/approved/rejected/cancelled
  approvedGrade String?
  reviewerId    String?
  reviewedAt    DateTime?
  item          CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 — Gamification
// ─────────────────────────────────────────────────────────────────────────────

model Badge {
  id       String      @id
  name     String
  category String // collection/cert/ranking/season
  emoji    String
  unit     String?
  rankMode Boolean     @default(false)
  tiers    BadgeTier[]
}

model BadgeTier {
  id        String @id @default(cuid())
  badgeId   String
  tier      String // SILVER/GOLD/DIAMOND
  threshold Int
  label     String
  holders   Int    @default(0)
  badge     Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@index([badgeId])
}

model UserBadge {
  id           String    @id @default(cuid())
  userId       String
  badgeId      String
  earnedTier   String?
  currentValue Int       @default(0)
  earnedAt     DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, badgeId])
  @@index([userId])
}

model Season {
  id       Int      @id
  name     String
  startsAt DateTime
  endsAt   DateTime
  active   Boolean  @default(false)
}

model RankingSnapshot {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime // 스냅샷 날짜 (00:00)
  rank           Int
  totalKrw       Int
  certifiedCount Int
  badgeCount     Int
  monthlyAdded   Int
  createdAt      DateTime @default(now())

  @@unique([userId, date])
  @@index([date, rank])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Marketplace
// ─────────────────────────────────────────────────────────────────────────────

model Listing {
  id         String         @id @default(cuid())
  itemId     String         @unique
  sellerId   String
  askingKrw  Int?
  negotiable Boolean        @default(true)
  dealMethod String // direct/delivery/both
  location   String?
  status     String         @default("active") // active/reserved/completed/hidden
  postId     String? // 커뮤니티 거래글 연동(선택)
  item       CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seller     User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  offers     Offer[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
  @@index([sellerId])
}

model Offer {
  id             String    @id @default(cuid())
  listingId      String
  buyerId        String
  proposedKrw    Int?
  status         String    @default("pending") // pending/accepted/declined/cancelled/completed
  conversationId String?
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?

  @@index([listingId])
  @@index([buyerId])
}

model Appointment {
  id      String   @id @default(cuid())
  offerId String?
  date    DateTime
  place   String
  status  String   @default("proposed") // proposed/confirmed/done/cancelled

  @@index([offerId])
}

model Review {
  id        String   @id @default(cuid())
  offerId   String?
  raterId   String
  rateeId   String
  rating    Int // 1..5
  manner    String // good/bad
  comment   String?
  createdAt DateTime @default(now())

  @@index([rateeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — Community
// ─────────────────────────────────────────────────────────────────────────────

model Post {
  id                  String    @id @default(cuid())
  userId              String
  collectibleCategory String // 포켓몬TCG/유희왕/...
  category            String // 정보/질문/자랑/팝니다/삽니다/...
  title               String
  body                String
  imageUrl            String?
  // 거래글 전용
  priceKrw            Int?
  condition           String?
  certified           Boolean   @default(false)
  location            String?
  dealMethod          String?
  tradeStatus         String?
  negotiable          Boolean   @default(false)
  // 메타
  isPinned            Boolean   @default(false)
  isHot               Boolean   @default(false)
  viewCount           Int       @default(0)
  likeCount           Int       @default(0)
  replyCount          Int       @default(0)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments            Comment[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([category])
  @@index([collectibleCategory])
  @@index([createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  body      String
  likeCount Int       @default(0)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([postId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Messaging (DM)
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  user1Id       String
  user2Id       String
  sourceType    String    @default("direct") // direct/card_inquiry/community_post
  sourceCardId  String?
  sourcePostId  String?
  lastMessageAt DateTime?
  messages      Message[]
  createdAt     DateTime  @default(now())

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachedCardId String?
  appointmentId  String?
  reviewId       String?
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model ConversationRead {
  id                String   @id @default(cuid())
  conversationId    String
  userId            String
  lastReadMessageId String?
  updatedAt         DateTime @updatedAt

  @@unique([conversationId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 — Cardgame Meta (큐레이션; DeckCard → LogicalCard 단위)
// ─────────────────────────────────────────────────────────────────────────────

model DeckArchetype {
  id          String           @id
  nameKo      String
  tier        String // S/A/B/C
  regulation  String // 스탠다드/익스텐디드/殿堂
  usageRate   Float            @default(0)
  winCount    Int              @default(0)
  avgRank     Float            @default(0)
  description String
  strengths   String[]
  weaknesses  String[]
  counters    String[]
  cards       DeckCard[]
  variants    DeckVariant[]
  trends      ArchetypeTrend[]
  updatedAt   DateTime         @updatedAt

  @@index([tier])
}

model DeckCard {
  id            String        @id @default(cuid())
  archetypeId   String
  logicalCardId String // 덱은 게임플레이라 LogicalCard 단위
  count         Int
  role          String? // ✓/⚠/✗
  archetype     DeckArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  logicalCard   LogicalCard   @relation("DeckCardLogicalCard", fields: [logicalCardId], references: [id])

  @@unique([archetypeId, logicalCardId])
  @@index([logicalCardId])
}

model DeckVariant {
  id          String        @id @default(cuid())
  archetypeId String
  nameKo      String
  archetype   DeckArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
}

model ArchetypeTrend {
  id          String        @id @default(cuid())
  archetypeId String
  week        String
  usage       Float
  archetype   DeckArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)

  @@index([archetypeId])
}

model Tournament {
  id                String   @id
  nameKo            String
  date              DateTime
  region            String // KR/JP/INTL
  format            String
  players           Int
  winnerArchetypeId String?
  status            String // upcoming/completed
  createdAt         DateTime @default(now())

  @@index([date])
}

model PlayerRanking {
  id             String   @id @default(cuid())
  season         Int
  rank           Int
  name           String
  csp            Int
  favArchetypeId String?
  wins           Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([season, rank])
}

model PullRate {
  id          String @id @default(cuid())
  setId       String
  rarity      String
  types       Int
  probability Float
  perBox      String

  @@index([setId])
}

model Ruling {
  id            String       @id @default(cuid())
  logicalCardId String? // nullable — 일반 룰링(특정 카드 무관) 허용
  question      String
  answer        String
  sourceUrl     String?
  logicalCard   LogicalCard? @relation("RulingLogicalCard", fields: [logicalCardId], references: [id])

  @@index([logicalCardId])
}

model GlossaryEntry {
  id         String  @id @default(cuid())
  term       String
  definition String
  example    String?
  locale     String  @default("ko")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 6 — Market analytics (마켓 랭킹: 상승률/거래량/트렌딩/낙폭/신고가)
// ─────────────────────────────────────────────────────────────────────────────

model MarketStat {
  id        String   @id @default(cuid())
  cardId    String
  date      DateTime
  priceKrw  Int?
  change1w  Float?
  change1m  Float?
  change3m  Float?
  txCount   Int      @default(0)
  volumeKrw Int      @default(0)
  athKrw    Int?
  viewDelta Float?
  wishlist  Int      @default(0)

  @@unique([cardId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 — 카드 중심 ERD 전환 (additive only; 기존 모델 무변경)
//   - LogicalCard: 언어 중립 인쇄본 정체성. Phase 4 에서 기존 Card→CardLocale rename 후 이 모델을 Card 로 rename.
//   - CardLocale: 지역별(언어/지역) 표시 데이터. Phase 2 에서 기존 Card 행을 복사 백필.
//   - Rarity / PriceSource: 마스터 데이터.
// ─────────────────────────────────────────────────────────────────────────────

model LogicalCard {
  id               String       @id @default(cuid())
  setGroupId       String?
  setGroup         SetGroup?    @relation("LogicalCardSetGroup", fields: [setGroupId], references: [id])
  primarySetId     String? // JP 원조 세트(있으면)
  primarySet       Set?         @relation("LogicalCardPrimarySet", fields: [primarySetId], references: [id])
  primaryNumber    String? // 원조 번호
  primaryNumberInt Int?
  pokedexNumbers   Int[] // 태그팀/유나이트(복수 포켓몬) 지원
  supertype        String?
  subtypes         String[]
  types            String[]
  hp               Int?
  retreatCost      Int?
  weakness         String?
  resistance       String?
  regulationMark   String?
  illustrator      String?
  evolvesFrom      String?
  evolvesTo        String[]
  abilities        Json?
  attacks          Json?
  legalities       Json?
  rules            String[]
  flavorText       String? // 영문 정규(폴백)
  rarityId         String?
  rarity           Rarity?      @relation(fields: [rarityId], references: [id])
  // ── 한국 유저 대상 한글 overlay (포켓몬코리아 공식 또는 번역 데이터) ──
  nameKo           String? // 카드/포켓몬 한국 공식 이름 (예: "이상해씨")
  attacksKo        Json? // [{ name, text, cost?, damage? }] 한국어
  abilitiesKo      Json? // [{ name, text, type }] 한국어
  rulesKo          String[]
  flavorTextKo     String?
  locales          CardLocale[]
  // Phase 5 신규 역관계
  collectionItems  CollectionItem[] @relation("CollectionItemLogicalCard")
  trades           Trade[]          @relation("TradeLogicalCard")
  tierEntries      TierEntry[]      @relation("TierEntryLogicalCard")
  deckCards        DeckCard[]       @relation("DeckCardLogicalCard")
  rulings          Ruling[]         @relation("RulingLogicalCard")
  externalIds      ExternalIdMapping[] @relation("ExternalIdMappingLogicalCard")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([setGroupId])
  @@index([rarityId])
  @@index([primarySetId])
}

model CardLocale {
  id            String      @id // = 기존 Card.id (호환 유지)
  logicalCardId String
  logicalCard   LogicalCard @relation(fields: [logicalCardId], references: [id])
  language      String // "en" | "ja" | "ko"
  region        String // "EN" | "JP" | "KR"
  setId         String
  set           Set         @relation("CardLocaleSet", fields: [setId], references: [id])
  number        String
  numberInt     Int?
  name          String
  flavorText    String?
  imageSmall    String?
  imageLarge    String?
  prices        Price[]     @relation("PriceCardLocale")
  // Phase 5 신규 역관계
  collectionItems CollectionItem[] @relation("CollectionItemLocale")
  trades          Trade[]          @relation("TradeLocale")
  externalIds     ExternalIdMapping[] @relation("ExternalIdMappingLocale")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // unique 제약 없음 — 같은 (setId, number) 라도 평행팩(SV2D/SV2P) · 레터 서브셋(15_A/15_B) 으로
  // 여러 행이 정당히 존재. 물리적 식별은 primary key(id)가 담당.
  @@index([setId, number, language])
  @@index([logicalCardId])
  @@index([setId])
  @@index([region])
}

model RarityCategory {
  id          String   @id @default(cuid())
  code        String   @unique // common, holo_rare, …
  nameKo      String
  nameJa      String?
  nameEn      String
  tier        Int      // 정렬용 (0~9)
  order       Int      // 표시 순서 (1~11)
  color       String?  // UI 색
  description String?  // 시각 특징 한줄 설명
  rarities    Rarity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Rarity {
  id         String          @id @default(cuid())
  code       String          @unique
  nameEn     String?
  nameJa     String?
  nameKo     String?
  tier       Int             @default(0)
  color      String?
  categoryId String?
  category   RarityCategory? @relation(fields: [categoryId], references: [id])
  cards      LogicalCard[]

  @@index([categoryId])
}

model PriceSource {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  defaultCurrency String // "USD" | "JPY" | "KRW"
  marketRegion    String // "GLOBAL" | "JP" | "KR" | "US"
  baseUrl         String?
  enabled         Boolean  @default(true)
  priority        Int      @default(0)
  prices          Price[]  @relation("PricePriceSource")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 — 외부 사이트 식별자 매핑 (다출처 데이터 정합 기반)
//   - 출처를 데이터(row)로 다뤄 sync 코드 변경 없이 출처 추가/비활성 가능
//   - 같은 카드에 출처 N개 동시 매핑 OK (sourceId가 달라 unique 안 깨짐)
// ─────────────────────────────────────────────────────────────────────────────

model ExternalSource {
  id        String              @id @default(cuid())
  code      String              @unique // "tcgcsv" | "pokemoncard_kr" | "tcgdex" | "poketrace" | "pokemontcg_io" ...
  name      String
  baseUrl   String?
  kind      String // "catalog" | "price" | "image" | "name_ko" | "name_ja" | "ruling"
  region    String? // "GLOBAL" | "JP" | "KR" | "EN"
  enabled   Boolean             @default(true)
  priority  Int                 @default(0) // 같은 kind 내 우선순위
  notes     String?
  mappings  ExternalIdMapping[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([kind])
  @@index([enabled])
}

model ExternalIdMapping {
  id            String          @id @default(cuid())
  sourceId      String
  externalId    String // 사이트 쪽 식별자 (productId/CardNum/poketraceId/…)
  // 매핑 대상 — 정확히 하나만 채움 (앱 레벨 검증)
  cardLocaleId  String?
  logicalCardId String?
  setId         String?
  setGroupId    String?
  url           String?
  verifiedAt    DateTime?
  verifiedBy    String? // userId or "auto:scriptname"
  confidence    Float           @default(1.0) // 0..1
  notes         String?
  source        ExternalSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  cardLocale    CardLocale?     @relation("ExternalIdMappingLocale", fields: [cardLocaleId], references: [id], onDelete: Cascade)
  logicalCard   LogicalCard?    @relation("ExternalIdMappingLogicalCard", fields: [logicalCardId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([sourceId, externalId])
  @@index([cardLocaleId])
  @@index([logicalCardId])
  @@index([setId])
  @@index([setGroupId])
}

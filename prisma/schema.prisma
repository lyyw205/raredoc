generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 지역별 발매판(printing) 1행. region 으로 EN/JP/KR 구분, setGroupId 로 동일 확장팩 연결.
model Set {
  id          String      @id
  name        String
  nameKo      String?
  nameJa      String?
  series      String
  releaseDate DateTime
  cardCount   Int
  logoUrl     String?
  symbolUrl   String?
  region      String      @default("EN") // EN | JP | KR
  code        String? // 지역 팩 코드 (EN ptcgoCode / JP sv2a / KR 사이트ID 등)
  cardPackId  String?     @map("setGroupId")
  cardPack    CardPack?   @relation(fields: [cardPackId], references: [id])
  primarySetForLogical Card[] @relation("LogicalCardPrimarySet")
  localeCards          RegionCard[]  @relation("CardLocaleSet")
  // Stage 4(ident): 팩 대응표 역관계 (CardPackLink) — additive
  packsAsSet    CardPackLink[] @relation("PackSet")
  packsAsMirror CardPackLink[] @relation("PackMirror")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([series])
  @@index([releaseDate])
  @@index([region])
  @@index([cardPackId], map: "Set_setGroupId_idx")
}

// 논리적 확장팩(예: "151"). 한 그룹에 지역별 Set 이 1~여러 개(EN이 JP 2팩을 합본하기도 함).
// 부분 그룹 허용: JP/KR 만 있고 EN 이 없을 수도 있음(예: MEGA 시리즈) — 억지 매핑 금지.
model CardPack {
  id          String    @id // slug 예: "sv-151", "sv-base", "mega-abysseye"
  era         String // SV | MEGA | ... (raw, 보존)
  nameEn      String?
  nameJa      String?
  nameKo      String?
  releaseDate DateTime? // 그룹 기준일(보통 일본 최초 발매) — 정렬용
  order       Int       @default(0)
  sets        Set[]
  // Phase 1 추가: 신규 ERD 역방향 relation
  cards Card[] @relation("LogicalCardCardPack")
  // Stage 4(ident): canonical era FK + 팩 대응표 — additive (era raw 필드는 보존)
  eraKey      String?
  eraRef      Era?           @relation(fields: [eraKey], references: [key])
  packs       CardPackLink[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([era])
  @@index([order])
  @@index([eraKey])
  @@map("SetGroup")
}

// Stage 4(ident): canonical era 사전 (eras.ts ERA_ORDER/ERA_LABEL 단일출처를 DB 1급화)
model Era {
  key     String     @id // "MEGA","SV",... (ERA_ORDER 값)
  order   Int        @unique // ERA_ORDER 내 인덱스(노출 순서, 신→구)
  labelKo String // ERA_LABEL[key]
  waves   CardPack[]
}

// Stage 4(ident): 팩(wave=CardPack) ↔ 지역 Set 대응표. build-group.ts CONFIG 의 DB 1급화.
// CONFIG 키 = CardPack.id = waveId. region/role/mirror 로 jp/kr/enNative/krMirror 인코딩.
model CardPackLink {
  id            String   @id @default(cuid())
  waveId        String // = CardPack.id (CONFIG 키)
  wave          CardPack @relation(fields: [waveId], references: [id], onDelete: Cascade)
  region        String // "JP"|"EN"|"KR"
  setId         String? // → Set.id. CROSS(enNative=null)·JP_ONLY 마커는 NULL
  set           Set?     @relation("PackSet", fields: [setId], references: [id])
  role          String // ANCHOR|NATIVE|MIRROR|CROSS|EN_ONLY|JP_ONLY 등
  relationType  String // ONE_TO_ONE|MERGE_N_TO_1|SPLIT_1_TO_N|CROSS|JP_ONLY|EN_ONLY 등
  mirrorOfSetId String? // krMirror{krSet→jpSet} 의 jpSet
  mirrorOfSet   Set?     @relation("PackMirror", fields: [mirrorOfSetId], references: [id])
  numberMirrors Boolean  @default(false) // krMirrorAll
  note          String?
  createdAt     DateTime @default(now())

  @@unique([waveId, region, setId])
  @@index([waveId])
  @@index([setId])
  @@index([region, role])
}

model Price {
  id           String       @id @default(cuid())
  regionCardId String       @map("cardLocaleId")
  regionCard   RegionCard   @relation("PriceCardLocale", fields: [regionCardId], references: [id], onDelete: Cascade)
  sourceId     String?
  priceSource  PriceSource? @relation("PricePriceSource", fields: [sourceId], references: [id])
  normal       Float?
  holofoil     Float?
  reverseHolo  Float?
  firstEdition Float?
  marketPrice  Float? // 단일값 출처용 일반 시세(등급가·샵 販売/買取·해외 한국판 등). raw 변형 다출처는 normal/holofoil 사용.
  currency     String       @default("USD")
  usdToKrw     Float?
  condition    String?
  gradingCompany String?
  grade        Int?
  recordedAt   DateTime     @default(now())

  @@index([regionCardId], map: "Price_cardLocaleId_idx")
  @@index([recordedAt])
  @@index([sourceId])
}

model Trade {
  id            String      @id @default(cuid())
  localeId      String // RegionCard.id — 실제 거래된 지역판
  cardId String @map("logicalCardId") // Card.id — 시장 분석 dedupe
  soldAt        DateTime
  priceHighUsd  Float
  priceLowUsd   Float?
  priceAvgUsd   Float?
  saleCount     Int         @default(1)
  tier          String      @default("NEAR_MINT")
  source        String      @default("poketrace")
  locale        RegionCard  @relation("TradeLocale", fields: [localeId], references: [id])
  card   Card @relation("TradeLogicalCard", fields: [cardId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([localeId, soldAt, tier, source])
  @@index([localeId])
  @@index([cardId], map: "Trade_logicalCardId_idx")
  @@index([soldAt])
  @@index([priceHighUsd])
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity / Auth (Auth.js v5 + Prisma Adapter)  — Phase 0
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String           @id @default(cuid())
  // Auth.js 표준 필드
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // 앱 프로필 필드 (OAuth 가입 직후엔 비어 있을 수 있어 nullable; 온보딩에서 채움)
  username      String?          @unique
  displayName   String?
  passwordHash  String?
  avatarInitial String?
  bio           String?
  tier          String           @default("BRONZE") // BRONZE/SILVER/GOLD/DIAMOND/LEGEND (파생·캐시)
  location      String?
  collection    CollectionItem[]
  posts         Post[]
  comments      Comment[]
  listings      Listing[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tier])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 — Collection
// ─────────────────────────────────────────────────────────────────────────────

model CollectionItem {
  id            String         @id @default(cuid())
  userId        String
  localeId      String // RegionCard.id — 실제 보유 지역판
  cardId String @map("logicalCardId") // Card.id — SetGroup-level 카운트(랭킹/도감 dedupe)
  grade         String // NM/LP/MP/HP/VNDS/DS/미개봉/1착
  certified     Boolean        @default(false)
  estimatedKrw  Int?
  forSale       Boolean        @default(false)
  highlightSlot Int? // 1..5 (프로필 하이라이트). null = 비표시
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale        RegionCard     @relation("CollectionItemLocale", fields: [localeId], references: [id])
  card   Card    @relation("CollectionItemLogicalCard", fields: [cardId], references: [id])
  certification Certification?
  listing       Listing?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([localeId])
  @@index([cardId], map: "CollectionItem_logicalCardId_idx")
  @@index([userId, forSale])
  @@index([createdAt])
}

model Certification {
  id            String         @id @default(cuid())
  itemId        String         @unique
  photoUrl      String
  status        String         @default("pending") // pending/approved/rejected/cancelled
  approvedGrade String?
  reviewerId    String?
  reviewedAt    DateTime?
  item          CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 — Gamification
// ─────────────────────────────────────────────────────────────────────────────

model Badge {
  id       String      @id
  name     String
  category String // collection/cert/ranking/season
  emoji    String
  unit     String?
  rankMode Boolean     @default(false)
  tiers    BadgeTier[]
}

model BadgeTier {
  id        String @id @default(cuid())
  badgeId   String
  tier      String // SILVER/GOLD/DIAMOND
  threshold Int
  label     String
  holders   Int    @default(0)
  badge     Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@index([badgeId])
}

model UserBadge {
  id           String    @id @default(cuid())
  userId       String
  badgeId      String
  earnedTier   String?
  currentValue Int       @default(0)
  earnedAt     DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, badgeId])
  @@index([userId])
}

model Season {
  id       Int      @id
  name     String
  startsAt DateTime
  endsAt   DateTime
  active   Boolean  @default(false)
}

model RankingSnapshot {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime // 스냅샷 날짜 (00:00)
  rank           Int
  totalKrw       Int
  certifiedCount Int
  badgeCount     Int
  monthlyAdded   Int
  createdAt      DateTime @default(now())

  @@unique([userId, date])
  @@index([date, rank])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Marketplace
// ─────────────────────────────────────────────────────────────────────────────

model Listing {
  id         String         @id @default(cuid())
  itemId     String         @unique
  sellerId   String
  askingKrw  Int?
  negotiable Boolean        @default(true)
  dealMethod String // direct/delivery/both
  location   String?
  status     String         @default("active") // active/reserved/completed/hidden
  postId     String? // 커뮤니티 거래글 연동(선택)
  item       CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seller     User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  offers     Offer[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
  @@index([sellerId])
}

model Offer {
  id             String    @id @default(cuid())
  listingId      String
  buyerId        String
  proposedKrw    Int?
  status         String    @default("pending") // pending/accepted/declined/cancelled/completed
  conversationId String?
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?

  @@index([listingId])
  @@index([buyerId])
}

model Appointment {
  id      String   @id @default(cuid())
  offerId String?
  date    DateTime
  place   String
  status  String   @default("proposed") // proposed/confirmed/done/cancelled

  @@index([offerId])
}

model Review {
  id        String   @id @default(cuid())
  offerId   String?
  raterId   String
  rateeId   String
  rating    Int // 1..5
  manner    String // good/bad
  comment   String?
  createdAt DateTime @default(now())

  @@index([rateeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — Community
// ─────────────────────────────────────────────────────────────────────────────

model Post {
  id                  String    @id @default(cuid())
  userId              String
  collectibleCategory String // 포켓몬TCG/유희왕/...
  category            String // 정보/질문/자랑/팝니다/삽니다/...
  title               String
  body                String
  imageUrl            String? // 호환 유지: images[0] 와 동기화 (목록 썸네일/구코드용)
  images              String[]  @default([]) // 거래글 다중 이미지 (번개장터식 갤러리)
  // 거래글 전용
  priceKrw            Int?
  condition           String?
  certified           Boolean   @default(false)
  location            String?
  dealMethod          String?
  tradeStatus         String?
  negotiable          Boolean   @default(false)
  // 메타
  isPinned            Boolean   @default(false)
  isHot               Boolean   @default(false)
  viewCount           Int       @default(0)
  likeCount           Int       @default(0)
  replyCount          Int       @default(0)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments            Comment[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([category])
  @@index([collectibleCategory])
  @@index([createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  body      String
  likeCount Int       @default(0)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([postId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Messaging (DM)
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  user1Id       String
  user2Id       String
  sourceType    String    @default("direct") // direct/card_inquiry/community_post
  sourceCardId  String?
  sourcePostId  String?
  lastMessageAt DateTime?
  messages      Message[]
  createdAt     DateTime  @default(now())

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachedCardId String?
  appointmentId  String?
  reviewId       String?
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model ConversationRead {
  id                String   @id @default(cuid())
  conversationId    String
  userId            String
  lastReadMessageId String?
  updatedAt         DateTime @updatedAt

  @@unique([conversationId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 — Cardgame Meta (큐레이션; DeckCard → Card 단위)
// ─────────────────────────────────────────────────────────────────────────────

model DeckArchetype {
  id            String           @id // = Limitless deck.id (예: "rockets-honchkrow")
  nameKo        String
  nameEn        String? // Limitless deck.name 원문
  iconKeys      String[] // Limitless deck.icons (히어로 카드 식별)
  region        String           @default("INTL") // 지역별 메타 분리 (현재 글로벌 집계만)
  tier          String // S/A/B/C — usageRate 임계값 파생 (15/8/3%)
  regulation    String // 스탠다드/익스텐디드 (殿堂은 Limitless 미제공이라 미사용)
  // ── 집계(파생) 필드: aggregate-meta 가 덮어씀 ──
  usageRate     Float            @default(0)
  winCount      Int              @default(0)
  avgRank       Float            @default(0)
  winRate       Float            @default(0) // 승률 (record 집계)
  conversion    Float            @default(0) // 입상률 (Top컷 진출 / 참가)
  consistency   Float            @default(0) // 안정성 (placing 분산 기반 지표)
  sampleSize    Int              @default(0) // 집계 표본 수 (신뢰도)
  isUnderdog    Boolean          @default(false) // 사용률↓ + 승률↑
  isTrap        Boolean          @default(false) // 사용률↑ + 승률→
  isMetaCounter Boolean          @default(false) // 상위덱 종합 우세
  // deckCostKrw 제거(2026-06-11 DB정리) — 0행·코드0참조, deckCostBudget/Premium 으로 대체
  // UI-1b 견적 캐시 2필드 — 토글은 프리캐시 스왑(실시간 재계산 금지, 리스크 P1-4). update-deck-costs.ts 갱신.
  deckCostBudget  Int? // 저레어 기준 합산(KRW)
  deckCostPremium Int? // 고레어 기준 합산(KRW)
  deckCostMeta    Json? // { pricedCount, totalCount, basis, asOf, hasExpensiveMissing } — 캡션·정직표기용
  // ── 편집 자산: 집계가 안 건드림 ──
  description   String           @default("")
  strengths     String[]
  weaknesses    String[]
  counters      String[]
  trends        ArchetypeTrend[]
  matchupsA     DeckMatchup[]    @relation("MatchupDeckA")
  matchupsB     DeckMatchup[]    @relation("MatchupDeckB")
  recipe        DeckRecipeCard[]
  regionStats   ArchetypeRegionStat[]
  updatedAt     DateTime         @updatedAt

  @@index([tier])
  @@index([region])
}

// 표준 레시피 — 아키타입별 카드 평균 채용 (decklist 집계). #16/#17
model DeckRecipeCard {
  id            String        @id @default(cuid())
  archetypeId   String
  archetype     DeckArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  region        String        @default("INTL") // INTL|JP|KR — region 별 레시피 (P2)
  cardName      String // Limitless decklist name (영문)
  setCode       String        @default("") // decklist set (예: "DRI") — ""=미상. NULL 금지: Postgres unique 의 NULL-distinct 로 upsert 중복증식 방지
  number        String        @default("") // decklist number — ""=미상
  category      String // pokemon/trainer/energy
  avgCount      Float // 평균 채용 수
  adoptionRate  Float // 채용률 (이 아키타입 덱 중 % 가 채용)
  cardId String? @map("logicalCardId") // 매칭된 우리 카드(시세/이미지용) — null 가능
  isCore        Boolean       @default(false) // 채용률 100% 근처 = 코어

  @@unique([archetypeId, region, cardName, setCode, number])
  @@index([archetypeId])
  @@index([cardId], map: "DeckRecipeCard_logicalCardId_idx")
}

// 덱 vs 덱 상성 (pairings 집계). #12/#13/#14
model DeckMatchup {
  id        String        @id @default(cuid())
  deckAId   String
  deckBId   String
  deckA     DeckArchetype @relation("MatchupDeckA", fields: [deckAId], references: [id], onDelete: Cascade)
  deckB     DeckArchetype @relation("MatchupDeckB", fields: [deckBId], references: [id], onDelete: Cascade)
  winsA     Int           @default(0) // A가 B를 이긴 횟수
  winsB     Int           @default(0)
  ties      Int           @default(0)
  games     Int           @default(0)
  winRateA  Float         @default(0) // A 기준 승률
  updatedAt DateTime      @updatedAt

  @@unique([deckAId, deckBId])
  @@index([deckAId])
}

model ArchetypeTrend {
  id          String        @id @default(cuid())
  archetypeId String
  region      String        @default("INTL") // 지역별 추이
  week        String // ISO week "2026-W22"
  usage       Float
  archetype   DeckArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)

  @@unique([archetypeId, region, week])
  @@index([archetypeId])
}

model Tournament {
  id                String                @id // = "{소스프리픽스}-{sourceId}" (lim-/lw-/jpc-/pd-...)
  source            String? // 정본 소스: limitless-play|limitless-web|jp-official|pokedata|ptcglegends — null=목업
  sourceId          String? // 정본 소스의 원본 ID
  metaRegion        String // INTL|JP|KR — 집계 파티션 (region 과 별개). default 없음: 수집기가 명시 입력 (누락 시 즉시 실패)
  level             String? // worlds|ic|regional|special|cl|league|city|online — 대회 필터 탭
  externalUrl       String? // 출처 링크
  nameKo            String
  name              String? // 원문(영문) 대회명
  date              DateTime
  region            String // 파생: 참가자 country 최빈값 (JP/US/KR/INTL) — 표시용 레거시
  format            String // STANDARD/EXPANDED/STANDARD_JP
  players           Int
  platform          String? // PTCGL/오프라인 등 (details.platform)
  winnerArchetypeId String? // = 1위 standing 의 deckKey
  status            String // upcoming/completed
  syncedAt          DateTime? // 마지막 standings 동기화 시각
  standings         TournamentStanding[]
  sourceRefs        TournamentSourceRef[]
  createdAt         DateTime              @default(now())

  @@unique([source, sourceId])
  @@index([date])
  @@index([region])
  @@index([metaRegion, date])
}

// 대회-소스 연결 (정본 primary / 보강 enrichment). 같은 원본이 두 Tournament 에 붙으면 DB 에러 → 이중집계 차단.
model TournamentSourceRef {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  source       String // kr-official|pokekameshi|limitless-jp|limitless-web|pokedata|ptcglegends
  sourceId     String // event_holding_id, pokedata ID 등
  role         String // primary|enrichment
  url          String?

  @@unique([source, sourceId])
  @@index([tournamentId])
}

// 대회별 입상 1행 (Limitless standings). 집계의 원천 데이터.
model TournamentStanding {
  id           String         @id @default(cuid())
  tournamentId String
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  placing      Int
  playerName   String
  country      String? // standings.country (US/JP/KR...)
  // deckKey 는 평문(FK 없음): sync 시점엔 archetype 미존재. aggregate 가 deckKey 로 archetype 생성 후 쿼리에서 수동 조인.
  deckKey      String? // Limitless deck.id (정본 아키타입 키) — 미제출이면 null
  deckName     String? // Limitless deck.name (영문 원문)
  deckIcons    String[] // Limitless deck.icons (대표 포켓몬 — 핵심 카드 식별)
  wins         Int            @default(0)
  losses       Int            @default(0)
  ties         Int            @default(0)
  decklist     Json? // 원본 데클리스트 보존 (레시피/카드매칭/검증용)
  playerUsername String? // 소스 username (pairings 매칭 안정화 — 표시명 비교 의존 해소)
  deckCode     String? // JP "XXXXXX-XXXXXX-XXXXXX" | KR recipe code — 복사 버튼 + 재수집 키
  archetypeRaw String? // 소스 원문 라벨 (ポケカ飯 일어명 등) — 사후 재분류 원천
  deckSource   String? // decklist provenance: limitless|jp-deckcode|kr-deckcode|pokedata
  createdAt    DateTime       @default(now())

  @@unique([tournamentId, placing])
  @@index([deckKey])
  @@index([tournamentId])
}

// 아키타입 × region 별 집계 (INTL|JP|KR). 본체 DeckArchetype 집계 컬럼은 INTL 미러로 의미 고정.
model ArchetypeRegionStat {
  id              String        @id @default(cuid())
  archetypeId     String
  archetype       DeckArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  region          String // INTL|JP|KR
  tier            String // S/A/B/C — sampleSize<30 이면 "—"
  usageRate       Float         @default(0)
  winCount        Int           @default(0)
  avgRank         Float         @default(0)
  winRate         Float         @default(0)
  conversion      Float         @default(0)
  consistency     Float         @default(0)
  sampleSize      Int           @default(0)
  tournamentCount Int           @default(0)
  isUnderdog      Boolean       @default(false)
  isTrap          Boolean       @default(false)
  isMetaCounter   Boolean       @default(false)
  updatedAt       DateTime      @updatedAt

  @@unique([archetypeId, region])
  @@index([region, tier])
}

model PlayerRanking {
  id             String   @id @default(cuid())
  season         Int
  rank           Int
  name           String
  csp            Int
  favArchetypeId String?
  wins           Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([season, rank])
}

model PullRate {
  id          String @id @default(cuid())
  setId       String
  rarity      String
  types       Int
  probability Float
  perBox      String

  @@index([setId])
}

model Ruling {
  id            String       @id @default(cuid())
  cardId String? @map("logicalCardId") // nullable — 일반 룰링(특정 카드 무관) 허용
  question      String
  answer        String
  sourceUrl     String?
  card   Card? @relation("RulingLogicalCard", fields: [cardId], references: [id])

  @@index([cardId], map: "Ruling_logicalCardId_idx")
}

model GlossaryEntry {
  id         String  @id @default(cuid())
  term       String
  definition String
  example    String?
  locale     String  @default("ko")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 6 — Market analytics (마켓 랭킹: 상승률/거래량/트렌딩/낙폭/신고가)
// ─────────────────────────────────────────────────────────────────────────────

model MarketStat {
  id        String   @id @default(cuid())
  cardId    String
  date      DateTime
  priceKrw  Int?
  change1w  Float?
  change1m  Float?
  change3m  Float?
  txCount   Int      @default(0)
  volumeKrw Int      @default(0)
  athKrw    Int?
  viewDelta Float?
  wishlist  Int      @default(0)

  @@unique([cardId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 — 카드 중심 ERD 전환 (additive only; 기존 모델 무변경)
//   - Card: 언어 중립 인쇄본 정체성. Phase 4 에서 기존 Card→RegionCard rename 후 이 모델을 Card 로 rename.
//   - RegionCard: 지역별(언어/지역) 표시 데이터. Phase 2 에서 기존 Card 행을 복사 백필.
//   - Rarity / PriceSource: 마스터 데이터.
// ─────────────────────────────────────────────────────────────────────────────

model Card {
  id               String       @id @default(cuid())
  cardPackId       String?      @map("setGroupId")
  cardPack         CardPack?    @relation("LogicalCardCardPack", fields: [cardPackId], references: [id])
  primarySetId     String? // JP 원조 세트(있으면)
  primarySet       Set?         @relation("LogicalCardPrimarySet", fields: [primarySetId], references: [id])
  primaryNumber    String? // 원조 번호
  primaryNumberInt Int?
  pokedexNumbers   Int[] // 태그팀/유나이트(복수 포켓몬) 지원
  supertype        String?
  subtypes         String[]
  types            String[]
  hp               Int?
  retreatCost      Int?
  weakness         String?
  resistance       String?
  regulationMark   String?
  illustrator      String?
  evolvesFrom      String?
  evolvesTo        String[]
  abilities        Json?
  attacks          Json?
  legalities       Json?
  rules            String[]
  flavorText       String? // 영문 정규(폴백)
  rarityId         String?
  rarity           Rarity?      @relation(fields: [rarityId], references: [id])
  // ── 한국 유저 대상 한글 overlay (포켓몬코리아 공식 또는 번역 데이터) — CardText 로 일원화 중 ──
  nameKo           String? // 한국 공식 이름 — 41파일 읽음, CardText 읽기이관 후 제거(Phase7)
  attacksKo        Json? // 한국어 — Tier2: CardText.attacks 백필(1169 누락) 후 제거 예정
  abilitiesKo      Json? // 한국어 — Tier2: CardText.abilities 백필(1169 누락) 후 제거 예정
  // rulesKo/flavorTextKo 제거(2026-06-11 DB정리) — CardText.ko 100% 커버·코드/스크립트 0참조
  locales          RegionCard[]
  texts            CardText[] // Phase 7: 언어별 표시 텍스트 오버레이(옵션 C). 향후 *Ko 컬럼 이관 대상.
  // Phase 5 신규 역관계
  collectionItems  CollectionItem[] @relation("CollectionItemLogicalCard")
  trades           Trade[]          @relation("TradeLogicalCard")
  rulings          Ruling[]         @relation("RulingLogicalCard")
  externalIds      ExternalIdMapping[] @relation("ExternalIdMappingLogicalCard")
  speciesLinks     CardSpecies[] @relation("LogicalCardSpeciesLink") // P1: 종(Species) N:M
  gameCardId       String? // P3: 게임상 같은 카드(oracle) — 덱/메타 dedup 단위
  gameCard         GameCard?    @relation("LogicalCardGameCard", fields: [gameCardId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([cardPackId], map: "LogicalCard_setGroupId_idx")
  @@index([rarityId], map: "LogicalCard_rarityId_idx")
  @@index([primarySetId], map: "LogicalCard_primarySetId_idx")
  @@index([gameCardId], map: "LogicalCard_gameCardId_idx")
  @@map("LogicalCard")
}

model RegionCard {
  id            String      @id // = 기존 Card.id (호환 유지)
  cardId String @map("logicalCardId")
  card   Card @relation(fields: [cardId], references: [id])
  language      String // "en" | "ja" | "ko"
  region        String // "EN" | "JP" | "KR"
  setId         String
  set           Set         @relation("CardLocaleSet", fields: [setId], references: [id])
  number        String
  numberInt     Int?
  name          String
  flavorText    String?
  imageSmall    String?
  imageLarge    String?
  // P4: art메타 하강(인쇄본별). Card 에서 기계복제(정정 없음 — region rarity 정정은 P5.5).
  rarityId      String?
  rarity        Rarity?     @relation("RarityLocale", fields: [rarityId], references: [id])
  // P4c: 인쇄본별 표시필드 — regMark/legalities 는 지역마다 갈릴 수 있어 RegionCard 유지(읽기 Card 폴백).
  //   게임필드(subtypes/weakness/resistance/retreatCost/evolvesFrom/evolvesTo)는 DB 전수 diff=0 순수복제라
  //   Card 직독으로 이관 후 제거(Stage A, 2026-06-11) — 게임값은 인쇄본 무관 = Card 단일소스.
  regulationMark String?
  legalities     Json?
  prices        Price[]     @relation("PriceCardLocale")
  // Phase 5 신규 역관계
  collectionItems CollectionItem[] @relation("CollectionItemLocale")
  trades          Trade[]          @relation("TradeLocale")
  externalIds     ExternalIdMapping[] @relation("ExternalIdMappingLocale")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // unique 제약 없음 — 같은 (setId, number) 라도 평행팩(SV2D/SV2P) · 레터 서브셋(15_A/15_B) 으로
  // 여러 행이 정당히 존재. 물리적 식별은 primary key(id)가 담당.
  @@index([setId, number, language])
  @@index([cardId], map: "CardLocale_logicalCardId_idx")
  @@index([setId])
  @@index([region])
  @@index([rarityId])

  @@map("CardLocale")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 7 — 언어별 표시 텍스트 오버레이 (옵션 C)
//   - "물리 발매판"(RegionCard)과 분리된 "번역/표시 텍스트" 축.
//   - (cardId, language) 유일. 한국인 기반 사이트라 ko 우선 노출, en/ja 는 "원문 보기" 토글.
//   - source 로 우선순위 표현: 공식 한국판 > 나무위키/포켓몬도감 > 자동번역.
//   - KR 발매판 없어도 ko 텍스트 보유 가능(번역으로 채움) → RegionCard 의존 끊음.
//   - Card.nameKo/attacksKo/abilitiesKo/rulesKo/flavorTextKo 를 일반화.
//     백필·읽기 이관 완료 후 그 컬럼들 제거 예정(이번엔 additive, 무중단).
// ─────────────────────────────────────────────────────────────────────────────
model CardText {
  id            String      @id @default(cuid())
  cardId String @map("logicalCardId")
  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  language      String // "ko" | "en" | "ja" | (확장: "zh" 등)
  name          String? // 카드/포켓몬 표시명 (예: "이상해씨")
  attacks       Json? // [{ name, text, cost?, damage? }] 해당 언어
  abilities     Json? // [{ name, text, type }] 해당 언어
  rules         String[] // 룰 텍스트(해당 언어)
  flavorText    String? // 플레이버(해당 언어)
  source        String      @default("auto") // "official_kr" | "namuwiki" | "pokemon_dict" | "tcgdex" | "pokemontcg_io" | "auto"
  confidence    Float       @default(1.0) // 0..1 (공식=1.0, 자동번역/추정 < 1.0)
  verifiedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([cardId, language], map: "CardText_logicalCardId_language_key")
  @@index([cardId], map: "CardText_logicalCardId_idx")
  @@index([language])
}

model RarityCategory {
  id          String   @id @default(cuid())
  code        String   @unique // common, holo_rare, …
  nameKo      String
  nameJa      String?
  nameEn      String
  tier        Int      // 정렬용 (0~9)
  order       Int      // 표시 순서 (1~11)
  color       String?  // UI 색
  description String?  // 시각 특징 한줄 설명
  rarities    Rarity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Rarity {
  id         String          @id @default(cuid())
  code       String          @unique
  nameEn     String?
  nameJa     String?
  nameKo     String?
  tier       Int             @default(0)
  color      String?
  categoryId String?
  category   RarityCategory? @relation(fields: [categoryId], references: [id])
  cards      Card[]
  localeCards RegionCard[]   @relation("RarityLocale") // P4: art메타 하강(인쇄본별 rarity)
  // Phase2(레어도 재정립): 표시 약어(JP식 C/U/R/RR/AR/SAR/SR/UR/HR/MUR) + 시대무관 정규 그룹 키.
  //   canonicalCode 가 C↔Common, Holo Rare↔Rare Holo, Art Rare↔Illustration Rare 등 출처별 중복을 통합.
  //   둘 다 additive·nullable — 원본 code/표시명은 보존(인쇄된 레어도 절대 미변경).
  abbr          String?
  canonicalCode String?

  @@index([categoryId])
  @@index([canonicalCode])
}

model PriceSource {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  defaultCurrency String // "USD" | "JPY" | "KRW"
  marketRegion    String // "GLOBAL" | "JP" | "KR" | "US"
  baseUrl         String?
  enabled         Boolean  @default(true)
  priority        Int      @default(0)
  prices          Price[]  @relation("PricePriceSource")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 — 외부 사이트 식별자 매핑 (다출처 데이터 정합 기반)
//   - 출처를 데이터(row)로 다뤄 sync 코드 변경 없이 출처 추가/비활성 가능
//   - 같은 카드에 출처 N개 동시 매핑 OK (sourceId가 달라 unique 안 깨짐)
// ─────────────────────────────────────────────────────────────────────────────

model ExternalSource {
  id        String              @id @default(cuid())
  code      String              @unique // "tcgcsv" | "pokemoncard_kr" | "tcgdex" | "poketrace" | "pokemontcg_io" ...
  name      String
  baseUrl   String?
  kind      String // "catalog" | "price" | "image" | "name_ko" | "name_ja" | "ruling"
  region    String? // "GLOBAL" | "JP" | "KR" | "EN"
  enabled   Boolean             @default(true)
  priority  Int                 @default(0) // 같은 kind 내 우선순위
  notes     String?
  mappings  ExternalIdMapping[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([kind])
  @@index([enabled])
}

model ExternalIdMapping {
  id            String          @id @default(cuid())
  sourceId      String
  externalId    String // 사이트 쪽 식별자 (productId/CardNum/poketraceId/…)
  // 매핑 대상 — 정확히 하나만 채움 (앱 레벨 검증)
  regionCardId  String?    @map("cardLocaleId")
  cardId String?    @map("logicalCardId")
  setId         String?
  cardPackId    String?    @map("setGroupId")
  url           String?
  verifiedAt    DateTime?
  verifiedBy    String? // userId or "auto:scriptname"
  confidence    Float           @default(1.0) // 0..1
  notes         String?
  source        ExternalSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  regionCard    RegionCard?     @relation("ExternalIdMappingLocale", fields: [regionCardId], references: [id], onDelete: Cascade)
  card   Card?    @relation("ExternalIdMappingLogicalCard", fields: [cardId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([sourceId, externalId])
  @@index([regionCardId], map: "ExternalIdMapping_cardLocaleId_idx")
  @@index([cardId], map: "ExternalIdMapping_logicalCardId_idx")
  @@index([setId])
  @@index([cardPackId], map: "ExternalIdMapping_setGroupId_idx")
}

// ─────────────────────────────────────────────────────────────────────────────
// P1 — Species (종) : 도감 네비/언어별 종 이름 전용. ★dedup 에는 절대 사용 안 함.
//   id = National Pokédex number(1..1025, PokeAPI 권위). data/pokeapi CSV 시드.
//   Card(→ 향후 ArtCard) 와 N:M (CardSpecies). 태그팀/유나이트=복수 dex.
//   트레이너/에너지는 무종(연결 없음). 메가/리전폼/Gmax 는 종 단위로 미분해(subtypes 유지).
// ─────────────────────────────────────────────────────────────────────────────
model Species {
  id               Int                  @id // National Pokédex number
  nameEn           String
  nameJa           String? // ja-hrkt(가나)
  nameKo           String?
  genusKo          String? // 분류(예: "씨앗포켓몬")
  generation       Int?
  evolvesFromId    Int? // 진화 전 종 id (느슨한 참조, FK 미강제)
  evolutionChainId Int?
  cards            CardSpecies[]

  @@index([nameKo])
  @@index([evolutionChainId])
}

// Card(아트 정체성) ↔ Species 다대다 조인. 태그팀은 한 LC가 복수 Species 행.
model CardSpecies {
  cardId String @map("logicalCardId")
  speciesId     Int
  card   Card @relation("LogicalCardSpeciesLink", fields: [cardId], references: [id], onDelete: Cascade)
  species       Species     @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([cardId, speciesId])
  @@index([speciesId], map: "LogicalCardSpecies_speciesId_idx")
  @@map("LogicalCardSpecies")
}

// ─────────────────────────────────────────────────────────────────────────────
// P3 — GameCard (게임상 같은 카드 = oracle) : 덱 4장 제한·채용률·게임 dedup 의 유일 권위.
//   묶음키 = [supertype, name, effectSig]. effectSig: 포켓몬=hp+공격damage집합+공격수+특성수,
//   트레이너/에너지=subtypes. ★빈-LC(로케일 0)는 제외(실물 없음).
//   ※ 시세/이미지 dedup엔 안 씀 — 그건 ArtCard(같은 그림) 단위.
//   id 는 결정적('gc_' + sha1(key) 앞 20) → 멱등 재빌드.
// ─────────────────────────────────────────────────────────────────────────────
model GameCard {
  id             String        @id
  supertype      String?
  name           String
  hp             Int? // 대표값
  // (oracle 본문 10컬럼 폐기 2026-06-11 Stage2 — regMark/retreat/weak/resist/evolves/abilities/attacks/legalities/rules.
  //  앱 read 0(gameCard select=supertype/hp뿐)인 사장복제. 게임값은 Card(코어) 직독.)
  cards          Card[] @relation("LogicalCardGameCard")

  @@index([supertype, name])
}

// ─────────────────────────────────────────────────────────────────────────────
// (ArtCard 폐기 2026-06-11 — Card 코어 전환. 같은그림 dedup은 후속 재설계.)

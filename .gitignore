# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local tool artifacts
/.playwright-mcp
/.omc
/.serena

# DB 백업/스키마 백업 (git 추적 제외)
*.bak
*.bak-*
prisma/backups/

# 세션 작업 산출물 (스크린샷·검토용 스프레드시트 — 루트 한정)
/*.jpeg
/*.png
/*.xlsx
designs/.omc/
designs/*.bak

# card-check 로케일 보존 스냅샷(임시 4MB 산출물 — 커밋 금지)
.card-check-locale-snapshot.json
.card-check-*.json

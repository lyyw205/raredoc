ographic Pok\u00e9 Ball logo on the card.\n\nThe *Play! Pok\u00e9mon* and holographic Pok\u00e9 Ball logos are also used for other Pok\u00e9mon League-related variants.","preferredOrder":null,"cardVariantSortingOrder":null},"68":{"id":68,"name":"I Choose You! Movie","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"69":{"id":69,"name":"Battle Road Autumn 2011 (1st Place)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"70":{"id":70,"name":"Battle Road Autumn 2011 (2nd Place)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"71":{"id":71,"name":"Battle Road Autumn 2011 (3rd Place)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"72":{"id":72,"name":"Winner Stamp","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"73":{"id":73,"name":"European POP Tournament","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":"This variant features a holographic Pok\u00e9 Ball logo on the bottom right of the artwork.","preferredOrder":null,"cardVariantSortingOrder":null},"74":{"id":74,"name":"Winner Stamp, Jumbo Size","isStandardSetType":false,"isParallelSetType":false,"isFirstE
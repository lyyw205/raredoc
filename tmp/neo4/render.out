andardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":"*Trainer Deck A* (also known as *Brock's Deck*) is a preconstructed deck for use with the Pok\u00e9mon League, Pewter City Season. *Trainer Deck A* was not sold publicly.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"238":{"id":238,"name":"Trainer Deck B","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":"*Trainer Deck B* (also known as *Misty's Deck*) is a preconstructed deck for use with the Pok\u00e9mon League, Cerulean City Season. *Trainer Deck B* was not sold publicly.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"239":{"id":239,"name":"Vivid Voltage Stamp, Jumbo Size","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":true,"descriptionMd":"See *Vivid Voltage Stamp* and *Jumbo Size*.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"240":{"id":240,"name":"Pok\u00e9mon the First Movie (Inverted Stamp)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":true,"isCombined":false,"descriptionMd":"This is an error variant of several *Wizards Black Star Promos* cards. Also see *Pok\u00e9mon the First Movie*.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"241":{"id":241,"name":"Non-holo (\"Toshinao Aoki\" Illustrator Error)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":"This is an error variant of *Moltres (Wizards Black Star Promos 21)*, *Articuno (Wizards Black Star Promos 22)* and *Zapdos (Wizards Black Star Promos 23)*. Also see *Non-holo*.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"243":{"id":243,"name":"Normal Holo (Evolution Box Error)","isStandardSetType":true,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":"This is an error variant of *Zapdos (Fossil 15\/62)*. Also see *Normal Holo*.","preferredOrder":null,"cardVariantSortingOrder":2990},"244":{"id":244,"name":"Cosmos Holo (1999 Copyright)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":"This variant of *Zapdos (Fossil 15\/62)* was handed out exclusively to employees of Wizards of the Coast. It features a *Cosmos Holo* holographic pattern instead of the default *Galaxy* pattern. The *1999* copyright distinguishes it from the *Thunderstorm Gift Box* *1999-2000* copyright variant.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"263":{"id":263,"name":"Normal Holo (Gray Background Error)","isStandardSetType":true,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":"This is an error variant of *Zekrom (Black & White 114\/114)*. Also see *Normal Holo*.\r\n","preferredOrder":null,"cardVariantSortingOrder":2990},"264":{"id":264,"name":"WC Deck 2019 (Mind Blown: Shintaro Ito)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"265":{"id":265,"name":"WC Deck 2019 (Perfection: Henry Brand)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"266":{"id":266,"name":"WC Deck 2019 (Fire Box: Kaya Lichtleitner)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCo
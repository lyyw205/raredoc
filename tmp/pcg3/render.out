)* was handed out exclusively to employees of Wizards of the Coast. It features a *Cosmos Holo* holographic pattern instead of the default *Galaxy* pattern. The *1999* copyright distinguishes it from the *Thunderstorm Gift Box* *1999-2000* copyright variant.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"263":{"id":263,"name":"Normal Holo (Gray Background Error)","isStandardSetType":true,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":"This is an error variant of *Zekrom (Black & White 114\/114)*. Also see *Normal Holo*.\r\n","preferredOrder":null,"cardVariantSortingOrder":2990},"264":{"id":264,"name":"WC Deck 2019 (Mind Blown: Shintaro Ito)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"265":{"id":265,"name":"WC Deck 2019 (Perfection: Henry Brand)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"266":{"id":266,"name":"WC Deck 2019 (Fire Box: Kaya Lichtleitner)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"267":{"id":267,"name":"25th Anniversary","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":"This variant features a yellow Pikachu face in the artwork with a red *2* and *5* as its cheeks.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"268":{"id":268,"name":"Glossy","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"ha
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Set {
  id          String   @id
  name        String
  nameKo      String?
  series      String
  seriesKo    String?
  releaseDate DateTime
  cardCount   Int
  logoUrl     String?
  symbolUrl   String?
  language    String   @default("en")
  cards       Card[]
  tierEntries TierEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([series])
  @@index([releaseDate])
}

model Card {
  id         String   @id
  setId      String
  name       String
  nameKo     String?
  number     String
  rarity     String?
  rarityKo   String?
  types      String[]
  supertype  String?
  subtypes   String[]
  artist     String?
  imageSmall String?
  imageLarge String?
  set        Set      @relation(fields: [setId], references: [id])
  prices     Price[]
  tierEntries TierEntry[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([setId])
  @@index([name])
  @@index([rarity])
}

model Price {
  id           String   @id @default(cuid())
  cardId       String
  normal       Float?
  holofoil     Float?
  reverseHolo  Float?
  firstEdition Float?
  source       String   @default("ebay")
  currency     String   @default("USD")
  usdToKrw     Float?
  recordedAt   DateTime @default(now())
  card         Card     @relation(fields: [cardId], references: [id])

  @@index([cardId])
  @@index([recordedAt])
}

model TierEntry {
  id       String @id @default(cuid())
  cardId   String
  setId    String
  tier     String
  reason   String?
  reasonKo String?
  card     Card   @relation(fields: [cardId], references: [id])
  set      Set    @relation(fields: [setId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([cardId, setId])
  @@index([setId])
  @@index([tier])
}
